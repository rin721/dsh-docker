# ============================================================================
# Repository-local runtime
# ============================================================================

RUNTIME_DIR=./.runtime
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# DSH image delivery
# ============================================================================

# auto  : 优先 docker pull 预构建镜像；拉取失败时自动回退本地 build。
# pull  : 只允许预构建镜像；拉取失败立即退出。
# build : 强制使用本仓库 Dockerfile 本地构建。
DSH_IMAGE_MODE=auto

# GitHub Actions 会将仓库镜像发布到此地址。
# 仓库维护者应把 GHCR package 设为 Public，普通用户才能匿名 pull。
DSH_IMAGE=ghcr.io/rin721/dsh-docker:latest

# ============================================================================
# Access mode
# ============================================================================

# local | domain-http | domain-https
ACCESS_MODE=local

# local 默认；domain-http CLI 会自动设为 0.0.0.0。
BIND_ADDRESS=127.0.0.1
DSH_PORT=3080

# domain-http / domain-https:
# DSH_DOMAIN=dsh.example.com

# domain-https:
# ACME_EMAIL=admin@example.com

EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_CADDY_VERSION=2.11.4

# ============================================================================
# Authentication
# ============================================================================

AUTH_REALM="DeepSeek Harness"
AUTH_BCRYPT_COST=14
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================================
# Remote HTTP compatibility
# ============================================================================

DSH_HTTP_COMPAT_SHIM=true

# ============================================================================
# Local-build toolchain (only used when DSH_IMAGE_MODE=build/fallback)
# ============================================================================

DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# Optional proxy
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,gateway,edge

DSH_EXTRA_TRUSTED_HOSTS=
