# DSH 对外访问域名
DSH_DOMAIN=dsh.example.com

# Tinyauth 登录域名。
# 建议和 DSH_DOMAIN 使用同一个父域，例如 auth.example.com + dsh.example.com。
AUTH_DOMAIN=auth.example.com

# Caddy 申请 ACME/Let's Encrypt 证书使用的联系邮箱
ACME_EMAIL=admin@example.com

# DeepSeek Harness npm 版本；latest 表示构建时安装最新版本。
# 生产环境建议确认版本后固定，例如 0.1.0-rc.x。
DSH_VERSION=latest

# Tinyauth 登录 Session 有效期，单位秒；默认 24 小时。
TINYAUTH_SESSION_EXPIRY=86400
