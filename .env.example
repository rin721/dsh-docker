# ============================================================================
# Repository-local runtime
# ============================================================================

# 所有生成/持久化数据默认位于 <repo>/.runtime。
RUNTIME_DIR=./.runtime

# DSH 容器 node 用户 UID/GID。
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# Access mode
# ============================================================================

# 支持：
#   local         - 默认。127.0.0.1:3080，适合本机/SSH Tunnel/外部反代。
#   domain-http   - 域名 + 纯 HTTP（No HTTPS），默认 0.0.0.0:80。
#   domain-https  - 域名 + Caddy 自动 HTTPS，Core 仍只监听 127.0.0.1:3080。
ACCESS_MODE=local

# local / domain-https 的 Core Gateway 监听。
# domain-http 模式使用 deploy.sh 自动切换为 0.0.0.0:80。
BIND_ADDRESS=127.0.0.1
DSH_PORT=3080

# domain-http / domain-https 使用。只填写主机名，不要写 http://、https:// 或路径。
# DSH_DOMAIN=dsh.example.com

# domain-https 使用。
# ACME_EMAIL=admin@example.com

# HTTPS Edge 监听。
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_CADDY_VERSION=2.11.4

# ============================================================================
# Authentication
# ============================================================================

AUTH_REALM="DeepSeek Harness"
AUTH_BCRYPT_COST=14
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================================
# Remote HTTP browser compatibility
# ============================================================================

# DeepSeek Harness 的 Web UI 在远程纯 HTTP Origin 下可能缺少
# crypto.randomUUID。DSH 容器前置一个零依赖 Node 代理，仅在原生 API
# 不存在时注入兼容实现；HTTPS/localhost 下不会覆盖浏览器原生实现。
#
# true  = 启用（推荐，尤其是 domain-http）
# false = 完全关闭 HTML 注入
DSH_HTTP_COMPAT_SHIM=true

# ============================================================================
# DeepSeek Harness / development toolchain
# ============================================================================

DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# 可选代理，传递给 DSH 容器内的 Node/curl/git/npm 等。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,gateway,edge

# 一般不需要。Gateway/兼容代理会把 DSH 上游 Host 固定为 localhost。
# DSH_EXTRA_TRUSTED_HOSTS=dsh.example.com,dsh.example.com:443
