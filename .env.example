# ============================================================================
# Repository-local runtime
# ============================================================================

# Default: all generated/persistent data lives inside <repo>/.runtime.
# Relative paths are resolved from compose.yaml (repository root).
# An absolute path is also supported when you intentionally want external data.
RUNTIME_DIR=./.runtime

# DSH node user and the official Tinyauth image use UID/GID 1000 in this stack.
# Root deployments use these values to align bind-mount ownership.
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# Core network
# No domain, TLS, 80 or 443 is required by the core deployment.
# ============================================================================

# 127.0.0.1 = only the host / local reverse proxy can connect (recommended)
# 0.0.0.0   = expose to all host interfaces (use only on trusted networks or
#             behind firewall/TLS)
BIND_ADDRESS=127.0.0.1

# Host ports published by the authentication gateway.
DSH_PORT=3080
AUTH_PORT=3081

# URL the user's browser uses to reach the Tinyauth login UI.
# Local test:  http://localhost:3081
# LAN:         http://192.168.1.20:9001
# Reverse proxy / production: https://auth.example.com
AUTH_URL=http://localhost:3081

# false for HTTP/local testing; true when AUTH_URL is HTTPS.
TINYAUTH_SECURE_COOKIE=false

TINYAUTH_SESSION_EXPIRY=86400
TINYAUTH_SESSION_MAX_LIFETIME=0
TINYAUTH_LOGIN_TIMEOUT=300
TINYAUTH_LOGIN_MAX_RETRIES=3
TINYAUTH_TRUSTED_PROXIES=
AUTH_UI_TITLE="DeepSeek Harness"

# Upstream images.
TINYAUTH_VERSION=v5.1.3
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================================
# DeepSeek Harness / development toolchain
# ============================================================================

# latest installs the newest @deepseek-ai/dsh available at build time.
# Pin this in long-lived environments for reproducible builds.
DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# Optional proxy inherited by commands running inside DSH.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,tinyauth,gateway

# Optional additional Host values accepted by DSH, comma-separated.
# Usually unnecessary because the internal gateway sends a stable Host to DSH.
# DSH_EXTRA_TRUSTED_HOSTS=dsh.example.com,dsh.example.com:443

# ============================================================================
# Optional HTTPS/domain edge
# Only used by: ./scripts/edge-up.sh
# ============================================================================

# DSH_DOMAIN=dsh.example.com
# AUTH_DOMAIN=auth.example.com
# ACME_EMAIL=admin@example.com

EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_CADDY_VERSION=2.11.4
