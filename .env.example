# ============================================================
# Repository-local runtime
# ============================================================

# Relative paths are resolved from compose.yaml (the repository root).
# Default: all generated/persistent state lives under <repo>/.runtime.
# You may use an absolute path if desired.
RUNTIME_DIR=./.runtime

# ============================================================
# Core network - no domain/TLS/80/443 requirement
# ============================================================

# 127.0.0.1: only host-local software/reverse proxy can access it (recommended)
# 0.0.0.0:   other machines can connect directly
BIND_ADDRESS=127.0.0.1
DSH_PORT=3080
AUTH_PORT=3081

# Public URL used by the browser to reach Tinyauth.
# Local example: http://127.0.0.1:3081
# LAN example:   http://192.168.1.20:9001
# Proxy example: https://auth.example.com
AUTH_URL=http://127.0.0.1:3081

TINYAUTH_SECURE_COOKIE=false
TINYAUTH_SESSION_EXPIRY=86400
TINYAUTH_LOGIN_MAX_RETRIES=3
AUTH_UI_TITLE="DeepSeek Harness"
TINYAUTH_VERSION=v5.1.3
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================
# DeepSeek Harness / dev toolchain
# ============================================================

DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# Optional proxy inside DSH container.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,tinyauth,gateway

# Optional additional Host values accepted by DSH, comma-separated.
# DSH_EXTRA_TRUSTED_HOSTS=dsh.example.com,dsh.example.com:443

# ============================================================
# Optional HTTPS/domain edge
# Only used by scripts/edge-up.sh
# ============================================================

# DSH_DOMAIN=dsh.example.com
# AUTH_DOMAIN=auth.example.com
# ACME_EMAIL=admin@example.com
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_CADDY_VERSION=2.11.4
