# ============================================================================
# Repository-local runtime
# ============================================================================

# Persistent state lives under the repository by default.
RUNTIME_DIR=./.runtime
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# Core listen
# ============================================================================

# Recommended: keep Core on loopback and reverse proxy it yourself.
BIND_ADDRESS=127.0.0.1
DSH_PORT=3080

# ============================================================================
# DSH image delivery
# ============================================================================

# auto  : pull prebuilt image first; fall back to local build if unavailable.
# pull  : only use the prebuilt image; fail immediately if pull fails.
# build : always build locally from Dockerfile.
DSH_IMAGE_MODE=auto
DSH_IMAGE=ghcr.io/rin721/dsh-docker:latest

# ============================================================================
# Authentication
# ============================================================================

AUTH_REALM="DeepSeek Harness"
AUTH_BCRYPT_COST=14
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================================
# Browser compatibility
# ============================================================================

# Helps DSH Web when it is ultimately accessed through a remote plain-HTTP
# reverse proxy and crypto.randomUUID is unavailable in the browser.
DSH_HTTP_COMPAT_SHIM=true

# ============================================================================
# DSH / local-build toolchain
# ============================================================================

DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# Optional proxy settings passed into the DSH container.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,gateway

DSH_EXTRA_TRUSTED_HOSTS=
