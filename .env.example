# ============================================================================
# Repository-local runtime
# ============================================================================

# 默认所有生成/持久化数据都保存在 <repo>/.runtime。
# 可以改成其他相对路径，也可以使用绝对路径。
RUNTIME_DIR=./.runtime

# DSH 镜像内 node 用户 UID/GID。root 部署时 init-runtime.sh 用于对齐 bind mount 权限。
RUNTIME_UID=1000
RUNTIME_GID=1000

# ============================================================================
# Core network
# Core 不要求域名、TLS、80/443。
# ============================================================================

# 127.0.0.1：只允许宿主机/本机反向代理访问，推荐默认值。
# 0.0.0.0：允许其他机器直接访问。若经过公网，必须在前面提供 HTTPS。
# 也可指定某个具体宿主机 IP。
BIND_ADDRESS=127.0.0.1

# 对外唯一入口端口：认证通过后进入 DSH。
DSH_PORT=3080

# 浏览器 Basic Auth 弹窗显示的 Realm。
AUTH_REALM="DeepSeek Harness"

# Caddy Basic Auth 使用 bcrypt。创建用户时的 bcrypt cost。
AUTH_BCRYPT_COST=14

# Gateway image
GATEWAY_CADDY_VERSION=2.11.4

# ============================================================================
# DeepSeek Harness / development toolchain
# ============================================================================

# latest = 镜像构建时安装 npm 上最新 @deepseek-ai/dsh。
# 长期部署建议固定到已验证版本。
DSH_VERSION=latest
DSH_PERMISSION_MODE=workspace-write
DSH_TELEMETRY_DISABLED=1
INSTALL_GO_DEV_TOOLS=true

NODE_VERSION=24.18.0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PNPM_VERSION=11.7.0

# 可选代理，传递给 DSH 容器内的 Node/curl/git/npm 等。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,dsh,gateway

# 一般不需要。Gateway 会把上游 Host 固定成 localhost:3080。
# 如有特殊 DSH Host 场景，可额外追加，逗号分隔。
# DSH_EXTRA_TRUSTED_HOSTS=dsh.example.com,dsh.example.com:443

# ============================================================================
# Optional Caddy HTTPS Edge
# 仅 ./scripts/edge-up.sh 使用；Core 部署不需要这些配置。
# ============================================================================

# DSH_DOMAIN=dsh.example.com
# ACME_EMAIL=admin@example.com

EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_CADDY_VERSION=2.11.4
