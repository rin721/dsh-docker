{
    auto_https off
    admin off
}

(common_security) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options "SAMEORIGIN"
    }
}

# Public login endpoint. No authentication is applied here, otherwise a
# redirect loop would be created.
:3081 {
    import common_security
    reverse_proxy tinyauth:3000
}

# Protected DeepSeek Harness endpoint.
:3080 {
    import common_security

    forward_auth tinyauth:3000 {
        uri /api/auth/caddy
        copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
    }

    reverse_proxy dsh:3080 {
        # DSH validates Host values. The gateway keeps the public host in
        # X-Forwarded-Host while presenting a stable trusted Host to DSH.
        header_up Host 127.0.0.1:3080
        flush_interval -1
    }
}
