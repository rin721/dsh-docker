{
	auto_https off
	admin off
}

:3080 {
	basic_auth bcrypt "{$AUTH_REALM}" {
		import /etc/caddy/auth/users.caddy
	}

	reverse_proxy dsh:3080 {
		# Preserve the original Host/Origin. The DSH compatibility proxy performs
		# same-origin validation, then normalizes the request to internal localhost.
		header_up -Authorization
		flush_interval -1
	}
}
